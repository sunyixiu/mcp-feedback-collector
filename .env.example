# MCP Feedback Collector — example environment (copy to .env for local CLI runs).
# When launched by Cursor, put these in the "env" block of mcp.json instead
# (see examples/mcp.json). Nothing here is required except MCP_TRANSPORT_MODE
# when running under Cursor.

# --- Transport (required for Cursor) ---------------------------------------
MCP_TRANSPORT_MODE="stdio"

# --- Local web UI -----------------------------------------------------------
# Fixed port for the feedback page. If it is already taken (e.g. a second Cursor
# window), the server falls back to the next free port; the tool result always
# contains the real URL.
MCP_WEB_PORT="18053"
# Bind address. Defaults to 127.0.0.1 (this machine only). The page has no
# login, so do not expose it to untrusted networks.
MCP_SERVER_HOST="127.0.0.1"
# Extra Host/Origin values the web UI may be reached with (comma separated,
# "host" or "host:port"). Use "*" to disable the Host/Origin check (not advised).
# MCP_ALLOWED_HOSTS=""
# Keep one stable URL; the page switches to each new session by itself.
MCP_USE_FIXED_URL="true"

# --- Session behaviour ------------------------------------------------------
# Seconds a feedback session waits for you before it is closed as "timed_out".
# This many timeouts in a row make the tool tell the agent to stop (default 30).
MCP_DIALOG_TIMEOUT="300"
# MCP_MAX_CONSECUTIVE_TIMEOUTS="30"

# --- Optional: AI chat tab + image-to-text (any OpenAI-compatible API) ------
# Leave these off unless you need them. When enabled, the key is served to the
# local web page, so keep the server on 127.0.0.1.
MCP_ENABLE_CHAT="false"
MCP_ENABLE_IMAGE_TO_TEXT="false"
# MCP_API_KEY="your_api_key_here"
# MCP_API_BASE_URL="https://api.openai.com"
# MCP_DEFAULT_MODEL="gpt-4o-mini"

# --- Storage / logging ------------------------------------------------------
# Pending-instruction queue location (default: ~/.mcp-feedback-collector).
# MCP_FEEDBACK_DATA_DIR=""
LOG_LEVEL="info"
# Troubleshooting only: write process events and the start of every stdout
# message to <tmpdir>/mcp-stdio-diag-<pid>.log. Off by default because the log
# can contain fragments of your feedback. Delete the files when you are done.
# MCP_STDIO_DIAG="true"
